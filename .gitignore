# Godot 4.2+ specific ignores
~*.dll

# Godot 4+ specific ignores
.godot/
.nomedia

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg
*.tmp

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Export outputs
*.exe
# Uncomment if your project does not version PCK files as runtime dependencies.
# *.pck

# ---- NFM Remastered ----
# the original game's launcher is part of the project
!/Madness.exe

# Epic Online Services keys stay private (copy eos.example.json to eos.json)
native/game/assets/eos.json

# Build outputs (rebuilt from source: Godot export + native/installer/build_installer.sh)
native/build/
native/ext/obj/
native/game/bin/*.dll

# Local tools: Godot editor, export templates, bundled JREs (downloaded, not source)
native/_tools/
data/jre/

# Package caches
remake/node_modules/
remake/dist/

# Benchmark captures (large, regenerated by the bench)
production/qa/evidence/perf/

# Per-machine session state and logs
production/session-state/
production/session-logs/
project.local.yaml

# OS noise
Thumbs.db
desktop.ini
.DS_Store
